# Copie para .env.local e preencha. Nunca envie o .env.local ao GitHub.

# --- Supabase (projeto novo, separado do Cadência) ---
# Project Settings > Data API (URL) e API Keys
NEXT_PUBLIC_SUPABASE_URL=https://COLE_AQUI.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=COLE_AQUI
SUPABASE_SECRET_KEY=COLE_AQUI

# Connect > Session pooler (troque [YOUR-PASSWORD] pela senha do banco).
# Usada só pelos scripts npm run db:migrate e db:seed; não vai para a Vercel.
DATABASE_URL=COLE_AQUI

# --- Stripe em modo de teste ---
# Developers > API keys, com o modo de teste ligado. Começam com pk_test_ e sk_test_.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=COLE_AQUI
STRIPE_SECRET_KEY=COLE_AQUI
# Developers > Webhooks, depois que o site estiver publicado. Começa com whsec_.
STRIPE_WEBHOOK_SECRET=COLE_AQUI

# --- E-mail (mesmo provedor do Cadência) ---
BREVO_API_KEY=
EMAIL_FROM=Orbe Gestão <seu-email@gmail.com>
